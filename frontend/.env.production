# Used by `npm run build` (Vercel production builds). Public on purpose: it is only the backend's address,
# which every visitor's browser needs. Never put secrets in a VITE_ variable. Local dev (`npm run dev`) ignores
# this file and uses the /api proxy in vite.config.ts.
VITE_API_URL=https://trustlens-api-p05f.onrender.com/api
