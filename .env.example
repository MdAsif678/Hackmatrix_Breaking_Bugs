# Copy this file to `.env` (same folder) and fill in values. NEVER commit .env.

# --- AI (P1 wrapper, used by P3) — Gemini key from https://aistudio.google.com/apikey ---
LLM_PROVIDER=gemini
LLM_API_KEY=
# optional, comma-separated fallback order (default: gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest)
LLM_MODEL=

# --- Threat intelligence (P2) ---
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# --- Blockchain (P4) — throwaway TESTNET wallet only ---
# Sepolia (demo): https://ethereum-sepolia-rpc.publicnode.com  (or an Alchemy/Infura Sepolia URL)
# Local Hardhat chain (development): http://127.0.0.1:8545 with Hardhat's public test key for account #0
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80   (worthless outside the local chain)
SEPOLIA_RPC_URL=
REGISTRY_PRIVATE_KEY=
# printed by `npm run deploy:local` / `npm run deploy:sepolia` in contracts/
REGISTRY_CONTRACT_ADDRESS=

# --- General ---
CHECK_TIMEOUT_SECONDS=8
# reports must be sealed on-chain within this many hours of creation (Verify rejects later seals)
REGISTRATION_WINDOW_HOURS=24
# true = replace not-yet-implemented analyzers with fake sample findings (for UI work / demos of the pipeline)
MOCK_ANALYZERS=false
